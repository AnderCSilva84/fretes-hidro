rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRootSuperadmin() {
      return isSignedIn() && request.auth.token.email == 'adm@acs.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userEmpresaId() {
      return userDoc().data.empresaId;
    }

    function userPerfil() {
      return userDoc().data.perfil;
    }

    function isGestor() {
      return isSignedIn() && userPerfil() in ['gestor', 'admin'];
    }

    function hasEmpresaScope() {
      return userEmpresaId() != null && userEmpresaId() != '';
    }

    function sameEmpresa(resourceData) {
      return isSignedIn() && resourceData.empresaId == userEmpresaId();
    }

    function sameEmpresaOnCreate() {
      return isSignedIn() && request.resource.data.empresaId == userEmpresaId();
    }

    function canAccessScopedCollection(resourceData) {
      return isSignedIn() && (
        !hasEmpresaScope()
        || sameEmpresa(resourceData)
      );
    }

    function canCreateScopedCollection() {
      return isSignedIn() && (
        !hasEmpresaScope()
        || sameEmpresaOnCreate()
      );
    }

    function isScopedCollection(collectionName) {
      return collectionName in [
        'clientes',
        'terminais',
        'embarcacoes',
        'rotasValores',
        'encomendas',
        'movimentacoes',
        'caixa',
        'viagens',
        'programacoesViagem',
        'passageiros',
        'passagens',
        'checkins'
      ];
    }

    function isManagementCollection(collectionName) {
      return collectionName in [
        'terminais',
        'embarcacoes',
        'rotasValores',
        'programacoesViagem'
      ];
    }

    function isOperationalCollection(collectionName) {
      return collectionName in [
        'clientes',
        'encomendas',
        'movimentacoes',
        'caixa',
        'viagens',
        'passageiros',
        'passagens',
        'checkins'
      ];
    }

    match /usuarios/{userId} {
      allow read: if isRootSuperadmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isRootSuperadmin();
    }

    match /empresas/{empresaId} {
      allow read: if isRootSuperadmin() || (isSignedIn() && empresaId == userEmpresaId());
      allow write: if isRootSuperadmin();
    }

    match /logsUso/{logId} {
      allow read, update, delete: if isRootSuperadmin();
      allow create: if isRootSuperadmin()
        || (isSignedIn() && request.resource.data.empresaId == userEmpresaId());
    }

    match /resumos/{resumoId} {
      allow read: if isSignedIn();
      allow write: if isRootSuperadmin();
    }

    match /{collectionName}/{docId} {
      allow read: if isRootSuperadmin()
        || (
          canAccessScopedCollection(resource.data)
          && isScopedCollection(collectionName)
        );

      allow create: if isRootSuperadmin()
        || (
          canCreateScopedCollection()
          && isScopedCollection(collectionName)
          && (
            isOperationalCollection(collectionName)
            || (isManagementCollection(collectionName) && isGestor())
          )
        );

      allow update: if isRootSuperadmin()
        || (
          canAccessScopedCollection(resource.data)
          && isScopedCollection(collectionName)
          && (
            isOperationalCollection(collectionName)
            || (isManagementCollection(collectionName) && isGestor())
          )
          && (
            !hasEmpresaScope()
            || request.resource.data.empresaId == resource.data.empresaId
          )
        );

      allow delete: if isRootSuperadmin()
        || (
          canAccessScopedCollection(resource.data)
          && isScopedCollection(collectionName)
          && isGestor()
        );
    }
  }
}
