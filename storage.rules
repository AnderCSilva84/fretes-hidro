rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRootSuperadmin() {
      return isSignedIn() && request.auth.token.email == 'adm@acs.com';
    }

    match /cadastros/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isRootSuperadmin();
    }
  }
}
